# Copy this file to .env and fill in your keys. Never commit .env.

# Which LLM the team uses, as provider:model
MODEL=openai:gpt-5-mini
# MODEL=groq:llama-3.3-70b-versatile

# API key for the provider you chose above
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Optional: trace every agent step in LangSmith (https://smith.langchain.com)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your_langsmith_api_key_here
