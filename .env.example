# Copy this file to .env and fill in your keys. Never commit .env.
# Variable names are case-sensitive on Linux (Streamlit Cloud, CI): use them exactly as written.

# Which LLM the team uses, as provider:model
MODEL=groq:openai/gpt-oss-120b
# MODEL=groq:openai/gpt-oss-20b        # faster, lighter
# MODEL=groq:qwen/qwen3.8-27b          # preview model, supports parallel tool calls
# MODEL=openai:gpt-5-mini              # needs OPENAI_API_KEY instead

# API key for the provider you chose above (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Optional tuning
# MAX_RETRIES=6              # retries with backoff on rate limits (429)
# GROQ_TEMPERATURE=0.3       # lower = more reliable tool calls

# Let agents write files, run Python and install packages (always with your approval).
# Set to false for public deployments.
ALLOW_CODE_EXECUTION=true

# Optional: password for the Streamlit app
# APP_PASSWORD=choose-a-password

# LangSmith tracing (https://smith.langchain.com): every agent, tool and LLM call
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=Multi_agent_datascience_team
