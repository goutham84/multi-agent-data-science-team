# Copy this file to .env and fill in your keys. Never commit .env.
# Variable names are case-sensitive on Linux (Streamlit Cloud, CI): use them exactly as written.

# ---- LLM: switch between Groq and OpenAI here ----
LLM_PROVIDER=groq                  # groq | openai
LLM_MODEL=openai/gpt-oss-120b      # Groq: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b
                                   # OpenAI: gpt-5-mini, gpt-5, gpt-4.1-mini ... (empty = provider default)
LLM_REASONING_EFFORT=low           # low | medium | high (reasoning models only; low = faster, fewer tokens)
# LLM_TEMPERATURE=0.3              # optional; default 0.3 on Groq, not sent to OpenAI
# MAX_RETRIES=6                    # retries with backoff on rate limits (429)

# API key for the provider above
GROQ_API_KEY=your_groq_api_key_here          # https://console.groq.com/keys
# OPENAI_API_KEY=your_openai_api_key_here    # https://platform.openai.com/api-keys

# Let agents write files, run Python and install packages (always with your approval).
# Set to false for public deployments. The Streamlit app is off unless this is set explicitly.
ALLOW_CODE_EXECUTION=true

# Optional: password for the Streamlit app
# APP_PASSWORD=choose-a-password

# LangSmith tracing (https://smith.langchain.com): every agent, tool and LLM call
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=Multi_agent_datascience_team
