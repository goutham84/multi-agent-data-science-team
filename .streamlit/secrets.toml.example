# Streamlit Community Cloud: App settings -> Secrets. EVERYTHING HERE IS OPTIONAL.
# Without secrets, visitors choose Groq or OpenAI in the sidebar and paste their own keys,
# and the app runs in safe mode (no file writes, code runs or installs).
# Locally, copy to .streamlit/secrets.toml (git-ignored) or use .env instead.
# Names are case-sensitive: GROQ_API_KEY, not Groq_API_KEY.

# Default choices in the sidebar
LLM_PROVIDER = "groq"                 # groq | openai
LLM_MODEL = "openai/gpt-oss-120b"
LLM_REASONING_EFFORT = "low"

# Your own keys: visitors can then chat without a key, on YOUR credits.
# If you add one, also set APP_PASSWORD so strangers can't use them up.
# GROQ_API_KEY = "gsk_..."
# OPENAI_API_KEY = "sk-..."
# APP_PASSWORD = "choose-a-password"

# LangSmith: tracing on by default, sent to your project (visitors can turn it off
# or use their own LangSmith key in the sidebar)
# LANGSMITH_TRACING = "true"
# LANGSMITH_ENDPOINT = "https://api.smith.langchain.com"
# LANGSMITH_API_KEY = "lsv2_pt_..."
# LANGSMITH_PROJECT = "Multi_agent_datascience_team"

# Safe mode is the default in the web app. Only for PRIVATE deployments:
# ALLOW_CODE_EXECUTION = "true"
