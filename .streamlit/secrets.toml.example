# Streamlit Community Cloud: paste these into App settings -> Secrets.
# Locally, copy to .streamlit/secrets.toml (git-ignored) or use .env instead.
# Names are case-sensitive: GROQ_API_KEY, not Groq_API_KEY.

MODEL = "groq:openai/gpt-oss-120b"
GROQ_API_KEY = "gsk_..."

# Public deployment: keep code execution off and protect your API credits
ALLOW_CODE_EXECUTION = "false"
APP_PASSWORD = "choose-a-password"

# LangSmith tracing
LANGSMITH_TRACING = "true"
LANGSMITH_ENDPOINT = "https://api.smith.langchain.com"
LANGSMITH_API_KEY = "lsv2_pt_..."
LANGSMITH_PROJECT = "Multi_agent_datascience_team"
